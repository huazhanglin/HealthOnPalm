{
  "name": "health-on-palm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "supabase:serve": "supabase functions serve mock-health-data --env-file supabase/.env",
    "supabase:deploy": "supabase functions deploy mock-health-data --project-ref zewznptbyhurxaqirzmb",
    "supabase:deploy:brief": "supabase functions deploy morning-brief recovery-score mock-health-data --project-ref zewznptbyhurxaqirzmb",
    "supabase:deploy:agent": "supabase functions deploy query-agent memory-working morning-brief safety-check recovery-score workout-agent mock-health-data --project-ref zewznptbyhurxaqirzmb",
    "supabase:deploy:workout": "supabase functions deploy workout-agent --project-ref zewznptbyhurxaqirzmb",
    "supabase:check:llm": "node supabase/scripts/check-llm.mjs",
    "supabase:test:safety": "node supabase/scripts/test-safety.mjs",
    "supabase:test:mock": "node supabase/functions/mock-health-data/test-local.mjs",
    "exercises:sync": "node supabase/scripts/sync-exercises.mjs --all --featured=160",
    "exercises:upload": "node supabase/scripts/sync-exercises.mjs --all --featured=160 --upload"
  },
  "dependencies": {
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.110.8",
    "next": "^15.3.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.8",
    "@types/node": "^22.15.29",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "eslint": "^9.28.0",
    "eslint-config-next": "^15.3.3",
    "supabase": "^2.109.1",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.3"
  }
