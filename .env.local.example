# ============================================================
# Health On Palm — 本地环境变量模板
# 使用方法：复制此文件为 .env.local，并填入 Supabase Dashboard 中的真实值
# 获取路径：Supabase Dashboard → Project Settings → API
# ============================================================

# --- 前端可公开（会打包进浏览器，仅使用 Anon Key）---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- 仅服务端使用（切勿添加 NEXT_PUBLIC_ 前缀）---
# Service Role Key 拥有绕过 RLS 的权限，禁止暴露给前端
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
